# Server Configuration
PORT=5050
NODE_ENV=development

# MongoDB Configuration (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/deficorp

# JWT Configuration
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=7d

# Cross-Origin Resource Sharing
# "*" allows any origin, or give a comma-separated list, e.g.
# CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Demo data: creates the demo accounts shown on the login page if they don't exist
SEED_DEMO_DATA=true

# Simulated blockchain network shown in the UI
BLOCKCHAIN_NETWORK_NAME=DeFiCorp Testnet
BLOCKCHAIN_CHAIN_ID=31337
